# Include this location in the existing TLS server for REHACONNECT_PUBLIC_URL.
# This upstream assumes Nginx runs on the host. For containerized Nginx, connect
# it to the private network and use rehaconnect:4101 instead.
location / {
    proxy_pass http://127.0.0.1:4103;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_connect_timeout 5s;
    proxy_read_timeout 220s;
    client_max_body_size 8m;
}
