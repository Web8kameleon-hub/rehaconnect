# Copy to .env.production on the deployment host; never commit real credentials.
RELEASE_ID=
LIGHTNING_DOCKER_NETWORK=
LIGHTNING_INTERNAL_URL=
REHACONNECT_PUBLIC_URL=
# Optional dedicated Cloudflare Tunnel; route its hostname to http://rehaconnect:4101.
CLOUDFLARE_TUNNEL_TOKEN=
# Example shapes: http://lightning-container:8080 and https://your-reha-domain
# Configure mail, Stripe, workflow access and model routes in Lightning itself.
