# Copy to .env.local in the repository root and enter your own values locally.
# This template contains no credentials. Do not commit .env.local.
# Either Resend or SMTP must be configured for real verification/recovery mail.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
# Lightning's real Stripe and plan settings; no example price IDs are supplied.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_SNAPSHOT=
STRIPE_WEBHOOK_SECRET_THIN=
LSPP_STRIPE_PLANS=
LSPP_LICENSE_SIGNING_KEY=
