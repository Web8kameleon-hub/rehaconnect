# Set these in your process environment. Spring does not load this file automatically.
LIGHTNING_INTERNAL_URL=http://127.0.0.1:4102
REHACONNECT_STORAGE_PATH=./data/rehaconnect.bin
REHACONNECT_PORT=4101
REHACONNECT_PUBLIC_URL=http://127.0.0.1:4103
# Configure these in the dedicated Lightning runtime, not in browser code.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_SNAPSHOT=
STRIPE_WEBHOOK_SECRET_THIN=
LSPP_PUBLIC_ORIGIN=http://127.0.0.1:4103
LSPP_DATA_DIR=
LONGO_URL=http://127.0.0.1:4100
# Use your RehaConnect price IDs in Lightning's existing plan mapping format.
LSPP_STRIPE_PLANS=
LSPP_LICENSE_SIGNING_KEY=
REHACONNECT_PRODUCTION=false
